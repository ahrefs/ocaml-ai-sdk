{
  "name": "tiny-js-sandbox-conformance",
  "private": true,
  "type": "module",
  "description": "Runs pi-codemode's sandbox scenarios against the tiny-js-sandbox binary",
  "dependencies": {
    "@earendil-works/pi-codemode": "1.4.0"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  },
  "scripts": {
    "test": "vitest run",
    "gen-prelude": "node gen-prelude.mjs",
    "gen-wrapper": "node gen-wrapper.mjs",
    "check-prelude": "node gen-prelude.mjs --check && node gen-wrapper.mjs --check"
  }
}
